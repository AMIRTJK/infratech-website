# Настройки backend на боевом сервере. Файл живёт в __INSTALL_DIR__/config/server.env
# и не меняется при обновлении сайта. После правки перезапустите службу "Infratech API".

NODE_ENV=production
PORT=4000
# API слушает только эту машину: снаружи к нему ходят через Caddy.
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=true
# Сайт и API на одном домене — CORS не нужен.
CORS_ORIGINS=

DATABASE_PATH=__INSTALL_DIR__/data/app.sqlite

# --- Почта ---
# Пока эти поля пустые, заявки сохраняются только в базу (выгрузка — export-requests.cmd).
# Заполнять SMTP_HOST, SMTP_USER, SMTP_PASSWORD и MAIL_TO нужно все сразу.
# Для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=ящик@gmail.com, SMTP_PASSWORD=пароль приложения из 16 букв (не обычный пароль).
# ВАЖНО: серверу нужен выход в интернет к smtp.gmail.com, порт 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=1 hour
