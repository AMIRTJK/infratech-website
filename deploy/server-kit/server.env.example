# Настройки backend на боевом сервере. Файл живёт в __INSTALL_DIR__/config/server.env
# и не меняется при обновлении сайта. После правки перезапустите службу "Infratech API".

NODE_ENV=production
PORT=4000
# API слушает только эту машину: снаружи к нему ходят через Caddy.
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=true
# Сайт и API на одном домене — CORS не нужен.
CORS_ORIGINS=

DATABASE_PATH=__INSTALL_DIR__/data/app.sqlite

# --- Почта ---
# Пока SMTP_HOST пустой, заявки сохраняются только в базу (выгрузка — export-requests.cmd).
# Почта компании — свой Exchange (mail.infratech.tj, 62.122.141.220) с самоподписанным сертификатом.
# Вариант без пароля (порт 25): SMTP_PORT=25, SMTP_SECURE=false, SMTP_USER и SMTP_PASSWORD пустые.
# Вариант с паролем ящика (порт 587): SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=info@infratech.tj, SMTP_PASSWORD=пароль от ящика.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# false — принимать самоподписанный сертификат почтового сервера (нужно для своего Exchange).
SMTP_TLS_REJECT_UNAUTHORIZED=false
MAIL_FROM=Сайт Infratech <info@infratech.tj>
MAIL_TO=info@infratech.tj

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=1 hour
