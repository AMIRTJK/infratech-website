# Скопируйте файл в .env.local и подставьте значения для своего окружения.
# .env.local в git не попадает (см. корневой .gitignore).

# Базовый адрес API backend для запросов ИЗ БРАУЗЕРА.
# Значение попадает в клиентский бандл — секретов здесь быть не может.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Базовый адрес API backend для запросов С СЕРВЕРА Next (RSC, generateMetadata, sitemap).
# В продакшене это может быть внутренний адрес, недоступный из интернета.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Публичный адрес самого сайта: канонические URL, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
