# Скопируйте файл в .env.local и подставьте значения для своего окружения.
# .env.local в git не попадает (см. корневой .gitignore).

# Базовый адрес backend для запросов ИЗ БРАУЗЕРА — без /api/v1, пути добавляет ApiRoutes.
# Значение попадает в клиентский бандл при сборке — секретов здесь быть не может.
# На проде НЕ задаётся: браузер ходит на тот же домен, прокси передаёт /api/* backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Базовый адрес backend для запросов С СЕРВЕРА Next (RSC, generateMetadata, sitemap), без /api/v1.
# Читается при запуске, а не при сборке; на проде — внутренний адрес http://127.0.0.1:4000.
API_INTERNAL_URL=http://localhost:4000

# Публичный адрес самого сайта: канонические URL, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
