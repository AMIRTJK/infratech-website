# Скопируйте файл в .env и подставьте значения для своего окружения.
# .env в git не попадает (см. корневой .gitignore). Секретов в репозитории быть не должно.
# На боевом сервере файл лежит вне папки приложения, путь к нему задаёт переменная ENV_FILE.

# --- Приложение ---
NODE_ENV=development
PORT=4000
# 127.0.0.1 — API доступно только с этой машины (на проде к нему ходит прокси Caddy).
HOST=0.0.0.0
# Уровень логирования pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true, если перед сервером стоит обратный прокси: тогда IP посетителя берётся из X-Forwarded-For.
TRUST_PROXY=false

# --- CORS ---
# Список источников через запятую. Звёздочка на публичном API не используется.
# На проде сайт и API на одном домене — список можно оставить пустым.
CORS_ORIGINS=http://localhost:3000

# --- База данных SQLite ---
# Путь к файлу базы: относительный — от директории server, или абсолютный. Файл в git не попадает.
DATABASE_PATH=./data/app.sqlite

# --- Почта (Nodemailer) ---
# Пока SMTP_HOST, SMTP_USER, SMTP_PASSWORD и MAIL_TO пустые, почта выключена:
# заявки сохраняются только в базу. Заполнять нужно все четыре сразу.
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=ящик@gmail.com, SMTP_PASSWORD=пароль приложения (не обычный пароль от почты).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Отправитель писем (если пусто — SMTP_USER). Пример: "Infratech <ящик@gmail.com>"
MAIL_FROM=
# Куда приходят заявки с формы; можно несколько адресов через запятую.
MAIL_TO=

# --- Ограничение частоты запросов ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Отдельный, более строгий лимит на отправку формы обратной связи (на каждую форму)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=1 hour
