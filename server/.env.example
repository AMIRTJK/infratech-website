# Скопируйте файл в .env и подставьте значения для своего окружения.
# .env в git не попадает (см. корневой .gitignore). Секретов в репозитории быть не должно.

# --- Приложение ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Уровень логирования pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- CORS ---
# Список источников через запятую. Звёздочка на публичном API не используется.
CORS_ORIGINS=http://localhost:3000

# --- База данных SQLite ---
# Путь к файлу базы относительно директории server. Файл в git не попадает.
DATABASE_PATH=./data/app.sqlite

# --- Почта (Nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Отправитель писем и адрес, куда падают заявки с формы обратной связи
MAIL_FROM="Название организации <noreply@example.com>"
MAIL_TO=info@example.com

# --- Ограничение частоты запросов ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Отдельный, более строгий лимит на отправку формы обратной связи
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=1 hour
