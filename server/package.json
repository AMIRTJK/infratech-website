{
  "name": "infratech-website-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend публичного сайта организации: Node.js + TypeScript + Fastify + SQLite + Nodemailer",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app/main.ts",
    "build": "tsc",
    "start": "node dist/app/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --test tests/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify-type-provider-zod": "^5.0.3",
    "zod": "^4.1.11",
    "better-sqlite3": "^12.4.1",
    "nodemailer": "^7.0.9",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^7.0.2",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "pino-pretty": "^13.1.2"
  }
}
